generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  ozonId      String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}