generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shops Shop[]
}

model Shop {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections OzonConnection[]
  products    Product[]
  stocks      Stock[]
  prices      Price[]
  orders      Order[]
  syncRuns    SyncRun[]
}

model OzonConnection {
  id           String    @id @default(cuid())
  shopId       String
  clientId     String
  apiKeyCipher String
  status       String    @default("pending")
  lastChecked  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId])
}

model Product {
  id           String   @id @default(cuid())
  shopId       String
  ozonId       String
  offerId      String
  sku          Int?
  name         String?
  archived     Boolean  @default(false)
  isDiscounted Boolean  @default(false)
  hasFbo       Boolean  @default(false)
  hasFbs       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  stocks Stock[]
  prices Price[]

  @@unique([shopId, ozonId])
}

model Stock {
  id        String   @id @default(cuid())
  shopId    String
  productId String
  source    String
  present   Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, source])
}

model Price {
  id        String   @id @default(cuid())
  shopId    String
  productId String
  price     Decimal  @db.Decimal(12, 2)
  oldPrice  Decimal? @db.Decimal(12, 2)
  minPrice  Decimal? @db.Decimal(12, 2)
  currency  String   @default("RUB")
  updatedAt DateTime @updatedAt

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId])
}

model Order {
  id          String   @id @default(cuid())
  shopId      String
  ozonOrderId String
  status      String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, ozonOrderId])
}

model SyncRun {
  id         String    @id @default(cuid())
  shopId     String
  status     String    @default("running")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
